<Application x:Class="MemoDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="AppFont">Microsoft YaHei UI</FontFamily>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F8" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8BECC" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#7F8798" />
        <SolidColorBrush x:Key="CardBrush" Color="#64192334" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#50627086" />
        <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#501A2436" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#4D64748A" />

        <LinearGradientBrush x:Key="SelectedTabBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#CC7467AA" Offset="0" />
            <GradientStop Color="#BA58719D" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E05A6FD8" Offset="0" />
            <GradientStop Color="#D35D50BC" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OuterBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B69580E8" Offset="0" />
            <GradientStop Color="#7D58789A" Offset="0.48" />
            <GradientStop Color="#59516B87" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#24FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TodoCheckStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Box"
                                    Background="#16FFFFFF"
                                    BorderBrush="#B9C0CD"
                                    BorderThickness="1.4"
                                    CornerRadius="5" />
                            <Path x:Name="CheckMark"
                                  Data="M 5,11 L 9,15 L 17,6"
                                  Stroke="#F6F7FB"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#75656EAF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#A89CE0" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#D5DBE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
