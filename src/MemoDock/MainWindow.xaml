<Window x:Class="MemoDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:MemoDock.Core.Models;assembly=MemoDock.Core"
        Title="MemoDock"
        Width="380"
        Height="720"
        MinWidth="330"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="86"
                            ResizeBorderThickness="8"
                            CornerRadius="22"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SegmentedTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface"
                                Margin="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SelectedTabBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#8FA5B5E0" />
                                <Setter Property="Foreground" Value="#FAFAFD" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionStyle" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Foreground" Value="#FAFBFF" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="#9698B6FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  ShadowDepth="3"
                                                  Opacity="0.23"
                                                  Color="#5169E0" />
                            </Border.Effect>
                            <Grid>
                                <Border Height="1"
                                        Margin="12,1,12,0"
                                        VerticalAlignment="Top"
                                        Background="#72FFFFFF"
                                        CornerRadius="1" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.91" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.73" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource OuterBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="22"
            Background="#DF09111E">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              ShadowDepth="8"
                              Opacity="0.45"
                              Color="#020712" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.Background>
                <RadialGradientBrush Center="0.94,0.05"
                                     GradientOrigin="0.94,0.05"
                                     RadiusX="0.75"
                                     RadiusY="0.48">
                    <GradientStop Color="#4D16427D" Offset="0" />
                    <GradientStop Color="#18111D35" Offset="0.5" />
                    <GradientStop Color="#000A111E" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <Border Margin="1"
                    BorderBrush="#36FFFFFF"
                    BorderThickness="1"
                    CornerRadius="21" />

            <Grid Margin="24,22,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            CornerRadius="12"
                            Background="#511D2639"
                            BorderBrush="#657C879E"
                            BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="FallbackIcon"
                                       Text="{}{ }"
                                       FontFamily="Consolas"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#69E2D4" Offset="0" />
                                        <GradientStop Color="#A88EF3" Offset="0.7" />
                                        <GradientStop Color="#6F86FF" Offset="1" />
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Image x:Name="CurrentAppIcon"
                                   Width="26"
                                   Height="26"
                                   Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="13,0,12,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentAppName"
                                   Text="正在识别软件…"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="本机私有记录"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource FlatButtonStyle}"
                            FontFamily="Segoe UI"
                            FontSize="23"
                            Content="×"
                            ToolTip="隐藏到托盘"
                            Click="CloseButton_Click" />
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,4,0,0"
                        Background="{StaticResource ControlSurfaceBrush}"
                        BorderBrush="{StaticResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Width="17"
                              Height="17"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 7.5,1.5 A 6,6 0 1 0 7.5,13.5 A 6,6 0 1 0 7.5,1.5 M 12,12 L 17.5,17.5"
                              Stretch="Uniform"
                              Stroke="#8E97A7"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Margin="0,0,12,0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="#D7DAE3"
                                     FontSize="13"
                                     TextChanged="SearchBox_TextChanged"
                                     GotKeyboardFocus="SearchBox_FocusChanged"
                                     LostKeyboardFocus="SearchBox_FocusChanged" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="搜索当前软件的记录"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,10,0,0"
                        Background="#4A192336"
                        BorderBrush="#48606E83"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="NotesTab"
                                     Grid.Column="0"
                                     GroupName="KindTabs"
                                     Content="笔记"
                                     Tag="Note"
                                     IsChecked="True"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Checked="Tab_Checked" />
                        <RadioButton Grid.Column="1"
                                     GroupName="KindTabs"
                                     Content="待办"
                                     Tag="Todo"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Checked="Tab_Checked" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,18,0,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ItemsControl x:Name="EntryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:MemoEntry}">
                                    <Border Margin="0,0,0,12"
                                            Padding="17"
                                            Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="13">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14"
                                                              ShadowDepth="3"
                                                              Opacity="0.16"
                                                              Color="#02050B" />
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Margin="0,3,12,0"
                                                      VerticalAlignment="Top"
                                                      IsChecked="{Binding IsCompleted}"
                                                      Click="TodoCheckBox_Click">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox"
                                                           BasedOn="{StaticResource TodoCheckStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}"
                                                                         Value="{x:Static models:MemoKind.Todo}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Opacity" Value="0.58" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Body}"
                                                           Margin="0,9,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12.5"
                                                           LineHeight="20"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Body}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.46" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Width="28"
                                                    Height="28"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource FlatButtonStyle}"
                                                    Tag="{Binding}"
                                                    Content="•••"
                                                    FontFamily="Segoe UI"
                                                    FontSize="12"
                                                    Click="CardMenu_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="还没有记录"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="点击下方按钮添加第一条"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Button Grid.Row="4"
                        Style="{StaticResource PrimaryActionStyle}"
                        Content="＋  新建记录"
                        Click="NewEntryButton_Click" />

                <TextBlock x:Name="HotKeyHint"
                           Grid.Row="5"
                           Text="Ctrl + Alt + N"
                           Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Segoe UI"
                           FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</Window>
